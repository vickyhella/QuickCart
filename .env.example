# Put *_DEVELOPMENT values in .env.development.local; keep Production values unsuffixed in Vercel Production.
# Vercel Preview uses *_PREVIEW values.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_DEVELOPMENT=USD
NEXT_PUBLIC_CURRENCY_PREVIEW=USD
NEXT_PUBLIC_SITE_URL=https://ginnynana.com
NEXT_PUBLIC_SITE_URL_DEVELOPMENT=http://localhost:3000
NEXT_PUBLIC_SITE_URL_PREVIEW=https://your-preview-domain.example
PAYLOAD_SECRET=
PAYLOAD_SECRET_DEVELOPMENT=
PAYLOAD_SECRET_PREVIEW=
DATABASE_URL=
# Local development uses DATABASE_URL_DEVELOPMENT when set; otherwise it uses the ignored local SQLite database.
DATABASE_URL_DEVELOPMENT=
# Vercel Preview uses the isolated preview database.
DATABASE_URL_PREVIEW=
PAYPAL_ENV=sandbox
PAYPAL_ENV_DEVELOPMENT=sandbox
PAYPAL_ENV_PREVIEW=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID_DEVELOPMENT=
PAYPAL_CLIENT_ID_PREVIEW=
PAYPAL_CLIENT_SECRET=
PAYPAL_CLIENT_SECRET_DEVELOPMENT=
PAYPAL_CLIENT_SECRET_PREVIEW=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_ID_DEVELOPMENT=
PAYPAL_WEBHOOK_ID_PREVIEW=
PAYPAL_CARD_PAYMENTS_ENABLED=false
PAYPAL_CARD_PAYMENTS_ENABLED_DEVELOPMENT=false
PAYPAL_CARD_PAYMENTS_ENABLED_PREVIEW=false
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Development R2 variables are optional; without them uploads use ignored local media folders.
R2_BUCKET_DEVELOPMENT=
R2_ENDPOINT_DEVELOPMENT=
R2_ACCESS_KEY_ID_DEVELOPMENT=
R2_SECRET_ACCESS_KEY_DEVELOPMENT=
R2_PUBLIC_URL_DEVELOPMENT=
# Configure separate R2 resources for Vercel Preview.
R2_BUCKET_PREVIEW=
R2_ENDPOINT_PREVIEW=
R2_ACCESS_KEY_ID_PREVIEW=
R2_SECRET_ACCESS_KEY_PREVIEW=
R2_PUBLIC_URL_PREVIEW=
PINTEREST_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN_DEVELOPMENT=
PINTEREST_ACCESS_TOKEN_PREVIEW=
PINTEREST_BOARD_ID=
PINTEREST_BOARD_ID_DEVELOPMENT=
PINTEREST_BOARD_ID_PREVIEW=
CRON_SECRET=
CRON_SECRET_DEVELOPMENT=
CRON_SECRET_PREVIEW=
