# Ginny Nana 环境变量模板
# 复制为 .env.development.local 后填写本地值；不要把填好密钥的文件提交到 Git。
# 生产环境使用无后缀变量；Netlify dev 分支使用 _PREVIEW；本地使用 _DEVELOPMENT。
# Netlify Secret 标注表示创建变量时是否勾选 Secret；同一组后缀变量沿用该建议。
# Netlify dev 分支部署时，在 Branch deploys context 设置 QUICKCART_ENVIRONMENT=preview 和下方 _PREVIEW 变量；不要用 `netlify env:import` 导入本模板，以免误设其他部署环境。
# Branch deploys 必需：DATABASE_URL_PREVIEW、PAYLOAD_SECRET_PREVIEW、R2_BUCKET_PREVIEW、R2_ENDPOINT_PREVIEW、R2_ACCESS_KEY_ID_PREVIEW、R2_SECRET_ACCESS_KEY_PREVIEW、R2_PUBLIC_URL_PREVIEW。
# NEXT_PUBLIC_SITE_URL_PREVIEW 建议填 dev 站点网址；PayPal Sandbox、Resend 邮件和 Pinterest 配置按需填写。
#
# Netlify 会自动提供 CONTEXT、URL、SITE_ID；Next.js 会提供 NODE_ENV；Vercel 会提供 VERCEL_ENV。
# 不要手动配置这些平台变量。QUICKCART_ENVIRONMENT 仅在 Netlify 分支部署时手动设为 preview。

# 网站公开设置
# NEXT_PUBLIC_SITE_URL：商品链接、Feed、订单邮件中的网站地址。生产建议填 https://ginnynana.com。
# 生产必需：否，但强烈建议设置正式域名；Netlify Secret：否（NEXT_PUBLIC_* 会进入浏览器）。
NEXT_PUBLIC_SITE_URL=https://ginnynana.com
NEXT_PUBLIC_SITE_URL_DEVELOPMENT=http://localhost:3000
NEXT_PUBLIC_SITE_URL_PREVIEW=https://your-dev-site.netlify.app

# NEXT_PUBLIC_CURRENCY：网站公开显示的币种；当前为 USD。
# 生产必需：否（默认 USD）；Netlify Secret：否。
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_DEVELOPMENT=USD
NEXT_PUBLIC_CURRENCY_PREVIEW=USD

# 部署环境选择
# QUICKCART_ENVIRONMENT：Netlify dev 分支部署必须设为 preview，让服务读取 _PREVIEW 配置。
# 生产必需：否（Netlify 自动识别）；Netlify Secret：否。dev 分支值：preview。
QUICKCART_ENVIRONMENT=

# Payload / 数据库 / 媒体存储
# DATABASE_URL：Neon PostgreSQL 连接地址。
# 生产必需：是；Netlify Secret：是（含数据库凭证）。
DATABASE_URL=
# PAYLOAD_SECRET：Payload 登录会话及安全签名密钥。每个环境使用独立随机值。
# 生产必需：是；Netlify Secret：是。
PAYLOAD_SECRET=
# R2_BUCKET：Cloudflare R2 bucket 名称。
# 生产必需：是；Netlify Secret：否（资源名称）。
R2_BUCKET=
# R2_ENDPOINT：R2 S3 API endpoint，例如 https://<account-id>.r2.cloudflarestorage.com。
# 生产必需：是；Netlify Secret：否（endpoint 地址）。
R2_ENDPOINT=
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY：R2 S3 API 凭证。
# 两项生产必需；Netlify Secret：两项都选是。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL：已公开访问的 R2 自定义域名或 public URL，不带末尾斜线更合适。
# 生产必需：是；Netlify Secret：否（公开媒体地址）。
R2_PUBLIC_URL=

# 本地开发可选值：未设置 DATABASE_URL_DEVELOPMENT 时使用项目忽略的本地 SQLite；R2 未配置时使用本地媒体目录。
# 本地变量建议：DATABASE_URL_DEVELOPMENT、PAYLOAD_SECRET_DEVELOPMENT、R2_*_DEVELOPMENT。
# 若配置数据库或 R2 凭证，Netlify Secret 建议与上面的对应项相同。
DATABASE_URL_DEVELOPMENT=
PAYLOAD_SECRET_DEVELOPMENT=
R2_BUCKET_DEVELOPMENT=
R2_ENDPOINT_DEVELOPMENT=
R2_ACCESS_KEY_ID_DEVELOPMENT=
R2_SECRET_ACCESS_KEY_DEVELOPMENT=
R2_PUBLIC_URL_DEVELOPMENT=

# Netlify dev 分支 / Preview 必须连接独立资源，禁止复用正式数据库和 R2 bucket。
# 这些变量在该部署环境为必需；Secret 建议与生产对应项相同。
DATABASE_URL_PREVIEW=
PAYLOAD_SECRET_PREVIEW=
R2_BUCKET_PREVIEW=
R2_ENDPOINT_PREVIEW=
R2_ACCESS_KEY_ID_PREVIEW=
R2_SECRET_ACCESS_KEY_PREVIEW=
R2_PUBLIC_URL_PREVIEW=

# PayPal（可选；未配置 Client ID 和 Secret 时结账不会提供 PayPal）
# PAYPAL_ENV：sandbox 或 live。正式收款时设 live；Netlify Secret：否。
PAYPAL_ENV=sandbox
PAYPAL_ENV_DEVELOPMENT=sandbox
PAYPAL_ENV_PREVIEW=sandbox
# PAYPAL_CLIENT_ID：PayPal 应用公开 ID。生产启用 PayPal 时必需；Netlify Secret：否。
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID_DEVELOPMENT=
PAYPAL_CLIENT_ID_PREVIEW=
# PAYPAL_CLIENT_SECRET：PayPal 应用凭证。生产启用 PayPal 时必需；Netlify Secret：是。
PAYPAL_CLIENT_SECRET=
PAYPAL_CLIENT_SECRET_DEVELOPMENT=
PAYPAL_CLIENT_SECRET_PREVIEW=
# PAYPAL_WEBHOOK_ID：对应 Sandbox / Live webhook 的 ID。生产接收 PayPal webhook 时需要；Netlify Secret：否。
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_ID_DEVELOPMENT=
PAYPAL_WEBHOOK_ID_PREVIEW=
# PAYPAL_CARD_PAYMENTS_ENABLED：高级银行卡字段开关。默认关闭；只有审核并验证后才设 true；Netlify Secret：否。
PAYPAL_CARD_PAYMENTS_ENABLED=false
PAYPAL_CARD_PAYMENTS_ENABLED_DEVELOPMENT=false
PAYPAL_CARD_PAYMENTS_ENABLED_PREVIEW=false

# Resend 订单邮件（可选；缺少任一项时邮件会跳过，不影响订单保存）
# RESEND_API_KEY：Resend API 密钥。启用生产订单邮件时必需；Netlify Secret：是。
RESEND_API_KEY=
RESEND_API_KEY_DEVELOPMENT=
RESEND_API_KEY_PREVIEW=
# ORDER_EMAIL_FROM：发件人名称和地址，例如 Ginny Nana <orders@已验证域名>。
# 启用生产订单邮件时必需；Netlify Secret：否。Resend 需先验证发信域名。
ORDER_EMAIL_FROM=
ORDER_EMAIL_FROM_DEVELOPMENT=
ORDER_EMAIL_FROM_PREVIEW=

# 定时任务与 Pinterest（可选；只在启用对应功能时填写）
# CRON_SECRET：保护清理媒体和 Pinterest 发布接口的 Bearer 密钥。
# 配置定时调用时必需；Netlify Secret：是。
CRON_SECRET=
CRON_SECRET_DEVELOPMENT=
CRON_SECRET_PREVIEW=
# PINTEREST_ACCESS_TOKEN：Pinterest API 访问令牌。启用自动发布时必需；Netlify Secret：是。
PINTEREST_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN_DEVELOPMENT=
PINTEREST_ACCESS_TOKEN_PREVIEW=
# PINTEREST_BOARD_ID：自动发布目标 Board ID。启用自动发布时必需；Netlify Secret：否。
PINTEREST_BOARD_ID=
PINTEREST_BOARD_ID_DEVELOPMENT=
PINTEREST_BOARD_ID_PREVIEW=

# 测试专用：schema migration 集成测试使用的临时 PostgreSQL 连接。不要配置到 Netlify。
# 仅运行该集成测试时需要；包含凭证，若存入 Netlify 应设为 Secret（通常无需存入 Netlify）。
MIGRATION_TEST_DATABASE_URL=
