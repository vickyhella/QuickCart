# Set this variable in Netlify's `dev` branch context only, never site-wide.
# Do not import this file with `netlify env:import`; that sets variables for all contexts.
# Enter secret values in Netlify UI; never commit a populated copy of this file.
QUICKCART_ENVIRONMENT=preview

# Required for the app and media uploads
DATABASE_URL_PREVIEW=
PAYLOAD_SECRET_PREVIEW=
R2_BUCKET_PREVIEW=
R2_ENDPOINT_PREVIEW=
R2_ACCESS_KEY_ID_PREVIEW=
R2_SECRET_ACCESS_KEY_PREVIEW=
R2_PUBLIC_URL_PREVIEW=

# Public site settings
NEXT_PUBLIC_SITE_URL_PREVIEW=
NEXT_PUBLIC_CURRENCY_PREVIEW=USD

# Optional: PayPal Sandbox checkout
PAYPAL_ENV_PREVIEW=sandbox
PAYPAL_CLIENT_ID_PREVIEW=
PAYPAL_CLIENT_SECRET_PREVIEW=
PAYPAL_WEBHOOK_ID_PREVIEW=
PAYPAL_CARD_PAYMENTS_ENABLED_PREVIEW=false

# Optional: order email testing
RESEND_API_KEY_PREVIEW=
ORDER_EMAIL_FROM_PREVIEW=
