{
  "name": "ecommerce-inngest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "migrate": "payload migrate",
    "migrate:preview": "node --import tsx/esm scripts/migrate-database.mts preview",
    "migrate:production": "node --import tsx/esm scripts/migrate-database.mts production",
    "migrate:woocommerce-data": "node --import tsx/esm scripts/migrate-woocommerce-customers-orders.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "seed:products": "node --import tsx/esm scripts/seed-products.mts",
    "seed:pages": "node --import tsx/esm scripts/seed-pages.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/db-sqlite": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "bcryptjs": "^3.0.3",
    "heic-convert": "^2.1.0",
    "next": "^16.4.1",
    "payload": "^3.90.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.5.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "sass": "^1.99.0",
    "undici": "^7.30.0"
  }
}
